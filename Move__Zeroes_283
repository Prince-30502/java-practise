
public class Move__Zeroes_283 {
    public static void main(String[] args) {
        int[]arr={2,0,5,6,7,0};
        int j=0;
        for(int i=0;i< arr.length;i++){
            if(arr[i]!=0){
                arr[j]=arr[i];
                j++;
            }
        }
        while(j<arr.length){
            arr[j]=0;
            j++;
        }
    }

}
